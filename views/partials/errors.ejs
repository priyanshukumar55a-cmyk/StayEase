<% if (errors.length > 0) { %>
    <div class="bg-accent-100 border border-accent-400 text-accent-700 px-4 py-3 rounded relative">
        <strong class="font-bold">Error!</strong>
        <ul class="mt-2 list-disc list-inside">
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    </div>
<% } %>