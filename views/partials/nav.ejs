<header class="bg-slate-100 backdrop-blur-md border-b-2 border-gray-300 sticky top-0 z-[1000] shadow-sm m-0">
    
    <div class="overflow-x-hidden px-6 py-4 flex items-center justify-between gap-10 m-0 w-full">
        
        <!-- Logo -->
         <div class="ml-10">
             <a href="/" class="flex items-center  gap-2">
                 <span class="text-2xl font-extrabold text-blue-600 tracking-tight">
                     StayEase
                 </span>
             </a>
         </div>

        <!-- Nav Links -->
        <div class="hidden md:flex items-center gap-2 sm:gap-3">

            <!-- Common Link -->
            <a href="/" 
                class="<%= currentPage === 'index' 
                    ? 'bg-blue-600 text-white shadow-lg' 
                    : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                    px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                <span class="inline-flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l9 8h-3v9h-4v-6h-4v6H6v-9H3l9-8z"/></svg>
                    Home
                </span>
            </a>

            <% if(isLoggedIn) { %>
                <% if(user && user.userType === 'guest') { %>
                    <a href="/homes" 
                        class="<%= currentPage === 'Home' 
                            ? 'bg-blue-600 text-white shadow-lg' 
                            : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                            px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                    <span class="inline-flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a1 1 0 0 1 .993.883L13 3v2.072a7.003 7.003 0 0 1 2.44 1.353l1.464-1.464a1 1 0 0 1 1.497 1.32l-1.542 2.048A6.978 6.978 0 0 1 19 11h2a1 1 0 1 1 0 2h-2a6.978 6.978 0 0 1-1.641 3.241l1.542 2.048a1 1 0 0 1-1.497 1.32l-1.464-1.464A7.003 7.003 0 0 1 13 18.928V21a1 1 0 1 1-2 0v-2.072a7.003 7.003 0 0 1-2.44-1.353l-1.464 1.464a1 1 0 0 1-1.497-1.32l1.542-2.048A6.978 6.978 0 0 1 5 13H3a1 1 0 1 1 0-2h2a6.978 6.978 0 0 1 1.641-3.241L4.099 5.711a1 1 0 1 1 1.497-1.32l1.464 1.464A7.003 7.003 0 0 1 11 5.072V3a1 1 0 0 1 1-1zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/></svg>
                        Explore
                    </span>
                    </a>

                    <a href="/favourites" 
                        class="<%= currentPage === 'favourites' 
                            ? 'bg-blue-600 text-white shadow-lg' 
                            : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                            px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                        <span class="inline-flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                            Favourites
                        </span>
                    </a>

                    <a href="/bookings" 
                        class="<%= currentPage === 'bookings' 
                            ? 'bg-blue-600 text-white shadow-lg' 
                            : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                            px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                        <span class="inline-flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10h10v2H7v-2zm0 4h7v2H7v-2zm9-9h2v2h-2V5zm-10 0h2v2H6V5zm0 14h2v2H6v-2zm10 0h2v2h-2v-2zM5 7V4h14v3h1a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1zm2-1h10V5H7v1z"/></svg>
                            Bookings
                        </span>
                    </a>
                <% } %>

                <!-- Divider -->
                <div class="hidden sm:block h-5 w-px bg-earth-300 mx-2"></div>

                <% if(user && user.userType === 'host') { %>
                    <a href="/host/host-home-list" 
                        class="<%= currentPage === 'host-homes' 
                            ? 'bg-blue-600 text-white shadow-lg' 
                            : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                            px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                        <span class="inline-flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M4 11.5V20a1 1 0 0 0 1 1h5v-6h4v6h5a1 1 0 0 0 1-1v-8.5l-8-6-8 6z"/></svg>
                            Host
                        </span>
                    </a>

                    <a href="/host/add-home" 
                        class="hidden sm:inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2 rounded-full text-sm font-semibold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 5v14m7-7H5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Add Home
                    </a>
                <% } %>

            <% } %>

            <% if(!isLoggedIn) { %>

                <div class="hidden sm:block h-5 w-px bg-earth-300 mx-2"></div>

                <a href="/login" 
                    class="<%= currentPage === 'login' 
                        ? 'bg-blue-600 text-white shadow-lg' 
                        : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                        px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                    <span class="inline-flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                        Login
                    </span>
                </a>

                <a href="/signup" 
                    class="<%= currentPage === 'signup' 
                        ? 'bg-blue-600 text-white shadow-lg' 
                        : 'text-earth-700 hover:bg-blue-50 hover:text-blue-600' %> 
                        px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                    <span class="inline-flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><path d="M20 8v6"/><path d="M23 11h-6"/></svg>
                        Sign Up
                    </span>
                </a>

            <% } else { %> 

                <form action="/logout" method="POST">
                    <button type="submit"
                        class="inline-flex items-center gap-2 text-earth-700 hover:bg-blue-50 hover:text-blue-600 px-4 py-2 rounded-full text-sm font-medium transition-all duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Logout
                    </button>
                </form>

            <% } %>

        </div>

        <!-- Mobile Menu Button -->
        <button id="menu-btn" class="md:hidden text-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu"
        class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-slate-200 shadow-2xl px-5 py-5 space-y-3 rounded-b-3xl">

        <!-- Home -->
        <a href="/"
            class="<%= currentPage === 'index'
                ? 'bg-blue-600 text-white shadow-lg'
                : 'text-slate-700 hover:bg-blue-50 hover:text-blue-600' %>
                flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold transition-all duration-300">

            <svg xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="currentColor">
                <path d="M12 3l9 8h-3v9h-4v-6h-4v6H6v-9H3l9-8z"/>
            </svg>

            Home
        </a>

        <% if(isLoggedIn) { %>

            <% if(user && user.userType === 'guest') { %>

                <!-- Section Label -->
                <p class="text-xs uppercase tracking-[0.2em] text-slate-400 font-bold pt-2 px-2">
                    Guest Panel
                </p>

                <!-- Explore -->
                <a href="/homes"
                    class="<%= currentPage === 'Home'
                        ? 'bg-blue-600 text-white shadow-lg'
                        : 'text-slate-700 hover:bg-blue-50 hover:text-blue-600' %>
                        flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold transition-all duration-300">

                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="currentColor">
                        <path d="M12 2a1 1 0 0 1 .993.883L13 3v2.072a7.003 7.003 0 0 1 2.44 1.353l1.464-1.464a1 1 0 0 1 1.497 1.32l-1.542 2.048A6.978 6.978 0 0 1 19 11h2a1 1 0 1 1 0 2h-2a6.978 6.978 0 0 1-1.641 3.241l1.542 2.048a1 1 0 0 1-1.497 1.32l-1.464-1.464A7.003 7.003 0 0 1 13 18.928V21a1 1 0 1 1-2 0v-2.072a7.003 7.003 0 0 1-2.44-1.353l-1.464 1.464a1 1 0 0 1-1.497-1.32l1.542-2.048A6.978 6.978 0 0 1 5 13H3a1 1 0 1 1 0-2h2a6.978 6.978 0 0 1 1.641-3.241L4.099 5.711a1 1 0 1 1 1.497-1.32l1.464 1.464A7.003 7.003 0 0 1 11 5.072V3a1 1 0 0 1 1-1zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/>
                    </svg>

                    Explore
                </a>

                <!-- Favourites -->
                <a href="/favourites"
                    class="<%= currentPage === 'favourites'
                        ? 'bg-blue-600 text-white shadow-lg'
                        : 'text-slate-700 hover:bg-blue-50 hover:text-blue-600' %>
                        flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold transition-all duration-300">

                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="currentColor">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>

                    Favourites
                </a>

                <!-- Bookings -->
                <a href="/bookings"
                    class="<%= currentPage === 'bookings'
                        ? 'bg-blue-600 text-white shadow-lg'
                        : 'text-slate-700 hover:bg-blue-50 hover:text-blue-600' %>
                        flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold transition-all duration-300">

                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="currentColor">
                        <path d="M7 10h10v2H7v-2zm0 4h7v2H7v-2zm9-9h2v2h-2V5zm-10 0h2v2H6V5zm0 14h2v2H6v-2zm10 0h2v2h-2v-2zM5 7V4h14v3h1a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1zm2-1h10V5H7v1z"/>
                    </svg>

                    Bookings
                </a>

            <% } %>

            <% if(user && user.userType === 'host') { %>

                <p class="text-xs uppercase tracking-[0.2em] text-slate-400 font-bold pt-2 px-2">
                    Host Panel
                </p>

                <a href="/host/host-home-list"
                    class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-300">

                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="currentColor">
                        <path d="M4 11.5V20a1 1 0 0 0 1 1h5v-6h4v6h5a1 1 0 0 0 1-1v-8.5l-8-6-8 6z"/>
                    </svg>

                    Host Dashboard
                </a>

                <a href="/host/add-home"
                    class="flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 to-cyan-500 text-white px-5 py-3 rounded-2xl text-sm font-bold shadow-lg hover:scale-[1.02] transition-all duration-300">

                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="currentColor">
                        <path d="M12 5v14m7-7H5"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"/>
                    </svg>

                    Add Home
                </a>

            <% } %>

            <!-- Logout -->
            <form action="/logout" method="POST" class="pt-2">
                <button type="submit"
                    class="w-full bg-red-50 text-red-600 hover:bg-red-100 px-4 py-3 rounded-2xl text-sm font-semibold transition-all duration-300">
                    Logout
                </button>
            </form>

        <% } else { %>

            <!-- Auth Buttons -->
            <div class="pt-2 space-y-3">

                <a href="/login"
                    class="block w-full text-center bg-gradient-to-r from-blue-600 to-cyan-500 text-white px-4 py-3 rounded-2xl text-sm font-bold shadow-lg hover:scale-[1.02] transition-all duration-300">
                    Login
                </a>

                <a href="/signup"
                    class="block w-full text-center border border-blue-200 text-blue-600 hover:bg-blue-50 px-4 py-3 rounded-2xl text-sm font-semibold transition-all duration-300">
                    Create Account
                </a>

            </div>

        <% } %>

    </div>

</header>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });
</script>