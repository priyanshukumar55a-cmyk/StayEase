<% if(successMessage.length > 0) { %>
    <script>
        alert("<%= successMessage[0] %>");
    </script>
<% } %>

<%- include('../partials/head') %>

<body class="min-h-screen flex flex-col overflow-hidden relative bg-white">
    
    <%- include('../partials/nav') %>

    <!-- Centering Wrapper -->
    <main class="flex-1 flex items-center justify-center px-4 py-10">
        
        <div class="bg-gradient-to-br from-indigo-400 via-fuchsia-500 to-pink-400 border-gray-300 rounded-3xl  backdrop-blur-sm p-8 md:p-10 w-full max-w-lg hover:scale-105 transition duration-300 shadow-lg">
            
            <div class="mb-5 text-center">
                <h1 class="text-4xl md:text-5xl font-extrabold text-blue-600 leading-tight">
                    Welcome Back
                </h1>
                <p class="text-sm md:text-base text-gray-700 leading-7 mt-3">Sign in to continue to your account</p>
            </div>


            <form action="/login" method="POST" class="space-y-5">
                <%- include('../partials/errors') %>
                <div>
                    <label class="block text-xs md:text-sm font-semibold text-gray-700 mb-2">Email</label>
                    <input 
                        type="email" 
                        name="email"
                        placeholder="Enter your email"
                        required
                        value="<%= oldInput.email %>"
                        class="w-full px-4 py-3 rounded-2xl border border-gray-300 text-sm md:text-base focus:outline-none focus:ring-4 focus:ring-blue-400/20 focus:border-blue-400 transition"
                    />
                </div>
                <div>
                    <label class="block text-xs md:text-sm font-semibold text-gray-700 mb-2">Password</label>
                    <input 
                        type="password" 
                        name="password" 
                        placeholder="Enter your password"
                        required
                        class="w-full px-4 py-3 rounded-2xl border border-gray-300 text-sm md:text-base focus:outline-none focus:ring-4 focus:ring-blue-400/20 focus:border-blue-400 transition"
                    />
                </div>
                
                <button type="submit" class="w-full bg-blue-600 text-white py-3.5 rounded-2xl text-base md:text-lg font-semibold hover:scale-105 transition duration-300 shadow-lg">
                    Sign In
                </button>
            </form>
        </div>

    </main>

</body>
</html>