<%- include('../partials/head') %>

<body class="min-h-screen flex flex-col overflow-x-hidden bg-gray-50">

<%- include('../partials/nav') %>

<main class="flex-1 flex items-center justify-center px-4 py-10 md:py-16">
    
    <div class="w-full max-w-6xl bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-200 grid grid-cols-1 md:grid-cols-2">

        <!-- Left Branding Section -->
        <div class="hidden md:flex flex-col justify-center items-center bg-gradient-to-br from-indigo-600 via-fuchsia-600 to-pink-500 text-white p-12 text-center">
            
            <h2 class="text-4xl lg:text-5xl font-extrabold mb-6 leading-tight">
                Join StayEase
            </h2>

            <p class="text-lg leading-8 text-white/90 max-w-sm">
                Find your next getaway or
                <span class="text-yellow-300 font-bold">list your property</span>
                and
                <span class="text-pink-200 font-bold">start earning today</span>.
            </p>

        </div>

        <!-- Form Section -->
        <div class="p-6 sm:p-8 md:p-10 lg:p-12 flex flex-col justify-center">

            <!-- Heading -->
            <div class="mb-8 text-center md:text-left">
                
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent leading-tight">
                    Create Account
                </h1>

                <p class="mt-3 text-sm sm:text-base text-gray-600 font-medium">
                    Start your journey with us
                </p>
            </div>

            <form action="/signup" method="POST" class="space-y-6">

                <%- include('../partials/errors') %>

                <!-- Names -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                    <div>
                        <label class="block text-xs font-bold text-fuchsia-700 uppercase tracking-widest mb-2">
                            First Name
                        </label>

                        <input
                            type="text"
                            name="firstName"
                            placeholder="John"
                            value="<%= oldInput.firstName %>"
                            required
                            class="w-full px-4 py-3 rounded-2xl border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition"
                        />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-fuchsia-700 uppercase tracking-widest mb-2">
                            Last Name
                        </label>

                        <input
                            type="text"
                            name="lastName"
                            placeholder="Doe"
                            value="<%= oldInput.lastName %>"
                            class="w-full px-4 py-3 rounded-2xl border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition"
                        />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-xs font-bold text-indigo-700 uppercase tracking-widest mb-2">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        placeholder="john@example.com"
                        value="<%= oldInput.email %>"
                        required
                        class="w-full px-4 py-3 rounded-2xl border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition"
                    />
                </div>

                <!-- Passwords -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                    <div>
                        <label class="block text-xs font-bold text-pink-700 uppercase tracking-widest mb-2">
                            Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            placeholder="••••••••"
                            value="<%= oldInput.password %>"
                            required
                            class="w-full px-4 py-3 rounded-2xl border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition"
                        />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-pink-700 uppercase tracking-widest mb-2">
                            Confirm Password
                        </label>

                        <input
                            type="password"
                            name="confirmPassword"
                            placeholder="••••••••"
                            value="<%= oldInput.confirmPassword %>"
                            required
                            class="w-full px-4 py-3 rounded-2xl border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition"
                        />
                    </div>
                </div>

                <!-- Account Type -->
                <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

                    <div class="flex items-center gap-6 flex-wrap">

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input
                                type="radio"
                                name="userType"
                                value="guest"
                                <%= oldInput.userType === 'guest' ? 'checked' : '' %>
                                class="accent-blue-600"
                            />

                            <span class="text-sm font-semibold text-indigo-600">
                                Guest
                            </span>
                        </label>

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input
                                type="radio"
                                name="userType"
                                value="host"
                                <%= oldInput.userType === 'host' ? 'checked' : '' %>
                                class="accent-blue-600"
                            />

                            <span class="text-sm font-semibold text-indigo-600">
                                Host
                            </span>
                        </label>

                    </div>

                    <label class="flex items-center gap-2 text-sm text-gray-700">
                        <input
                            type="checkbox"
                            name="terms"
                            <%= oldInput.terms ? 'checked' : '' %>
                            required
                            class="accent-blue-600 w-4 h-4"
                        />

                        Agree to
                        <span class="text-blue-600 font-bold">
                            Terms
                        </span>
                    </label>

                </div>

                <!-- Submit -->
                <button
                    type="submit"
                    class="w-full bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white py-3.5 rounded-2xl text-base md:text-lg font-bold shadow-lg hover:scale-[1.02] transition-all duration-300"
                >
                    Join StayEase
                </button>

                <!-- Footer -->
                <p class="text-sm text-center text-gray-600">
                    Already have an account?
                    <a href="/login" class="text-blue-600 font-bold hover:underline">
                        Login
                    </a>
                </p>

            </form>
        </div>
    </div>
</main>

</body>
</html>





