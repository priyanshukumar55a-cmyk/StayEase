<%- include('../partials/head') %>
</head>
<body class="bg-white font-sans">
    <%- include('../partials/nav') %>

    <!-- Hero Section -->
    <main class="max-w-6xl mx-auto px-4 py-10">
        <h1 class="text-4xl font-extrabold text-blue-600 text-center mb-2">
            Your Favourites
        </h1>
        <p class="text-center text-earth-800 text-lg mb-8">Your collection of amazing places to stay</p>
        <div class="max-w-6xl mx-auto mt-10 px-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

        <% favouriteHomes.forEach(home => { %>
            
            <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 overflow-hidden border border-gray-200 hover:-translate-y-1">
                
                <!-- Image -->
                <div class="overflow-hidden">
                    <img 
                        src="<%= home.photo || 'https://via.placeholder.com/400x300?text=No+Image' %>" 
                        alt="<%= home.homeName %>"
                        class="w-full h-48 object-cover hover:scale-105 transition duration-300"
                    />
                </div>

                <!-- Content -->
                <div class="p-4">
                    
                    <!-- House Name -->
                    <h2 class="text-lg font-bold text-earth-800 mb-1 truncate">
                        <%= home.homeName %>
                    </h2>

                    <!-- Location -->
                    <p class="text-earth-700 text-sm mb-2">
                        📍 <%= home.address || 'Location not available' %>
                    </p>

                    <!-- Rating -->
                    <p class="text-primary-700 text-sm font-semibold mb-2">
                        ⭐ <%= home.rating %> / 5
                    </p>

                    <!-- Price -->
                    <p class="text-earth-900 font-semibold text-lg mb-4">
                        ₹<%= home.price %> 
                        <span class="text-earth-700 text-sm font-normal">/ night</span>
                    </p>

                    <form action="/favourite/delete/<%= home._id %>" method="post">
                        <button type="submit" class="w-full bg-accent-500 text-white p-2 rounded-lg font-semibold hover:bg-accent-600 hover:shadow-lg transition duration-300 mt-2">
                            Remove from Favourites
                        </button>
                    </form>

                </div>
            </div>

        <% }) %>

    </div>
    </main>

</body>
</html>