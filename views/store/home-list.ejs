<%- include('../partials/head') %>
</head>
<body class="bg-white font-sans">
    <%- include('../partials/nav') %>

    <!-- Hero Section -->
    <main class="max-w-6xl mx-auto px-4 py-10">
        <div class="max-w-6xl mx-auto mt-10 px-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

        <% registeredHomes.forEach(home => { %>
            
            <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 overflow-hidden border border-gray-200 hover:-translate-y-1">
                
                <!-- Image -->
                <div class="overflow-hidden">
                    <img 
                        src="<%= home.photo || 'https://via.placeholder.com/400x300?text=No+Image' %>" 
                        alt="<%= home.homeName %>"
                        class="w-full h-48 object-cover hover:scale-105 transition duration-300"
                    />
                </div>

                <!-- Map Section -->
                <div id="mapSection-<%= home._id %>" class="hidden h-48">
                    <div 
                        id="map-<%= home._id %>" 
                        class="w-full h-full"
                        data-lat="<%= home.location.coordinates[1] %>"
                        data-lng="<%= home.location.coordinates[0] %>">
                    </div>
                </div>

                <!-- Tabs -->
                <div class="flex gap-2 p-2 bg-gray-100 font-semibold">
                    <button onclick="toggleMap('<%= home._id %>')" id="mapBtn-<%= home._id %>" class="px-3 py-1 bg-cyan-100 text-cyan-700 rounded hover:bg-gradient-to-r hover:from-cyan-500 hover:to-blue-500 hover:text-white transition font-semibold">Map</button>
                </div>

                <!-- Content -->
                <div class="p-4">
                    
                    <!-- House Name -->
                    <h2 class="text-lg font-bold text-earth-800 mb-1 truncate">
                        <%= home.homeName %>
                    </h2>

                    <!-- Location -->
                    <p class="text-earth-700 text-sm mb-2">
                        📍 <%= home.address || 'Location not available' %>
                    </p>

                    <!-- Rating -->
                    <p class="text-amber-500 text-sm font-bold mb-2">
                        ⭐ <%= home.rating %> / 5
                    </p>

                    <!-- Price -->
                    <p class="text-emerald-600 font-bold text-lg mb-4">
                        ₹<%= home.price %> 
                        <span class="text-slate-600 text-sm font-normal">/ night</span>
                    </p>

                    <!-- Button -->
                    <a href="/homes/<%= home._id %>"
                    class="w-full flex items-center justify-center bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-2.5 rounded-xl font-semibold tracking-wide shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300 ease-in-out">
                    View Details
                    </a>

                    <!-- Add to favourite-->
                    <%- include('../partials/favourite', {home: home}) %>

                </div>
            </div>

        <% }) %>

    </div>
    </main>

<script>
const maps = {};
const openedMaps = new Set();

function toggleMap(id) {
    const mapSection = document.getElementById('mapSection-' + id);
    const mapDiv = document.getElementById('map-' + id);

    // 👉 If already open → CLOSE it
    if (openedMaps.has(id)) {
        mapSection.classList.add('hidden');
        openedMaps.delete(id);
        return;
    }

    // 👉 Close all other maps (optional but better UI)
    openedMaps.forEach(openId => {
        document.getElementById('mapSection-' + openId).classList.add('hidden');
    });
    openedMaps.clear();

    // 👉 Open this map
    mapSection.classList.remove('hidden');
    openedMaps.add(id);

    // 👉 Initialize map only once
    if (!maps[id]) {
        const lat = parseFloat(mapDiv.dataset.lat);
        const lng = parseFloat(mapDiv.dataset.lng);

        const map = L.map('map-' + id).setView([lat, lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

        L.marker([lat, lng]).addTo(map);

        maps[id] = map;
    } else {
        setTimeout(() => {
            maps[id].invalidateSize();
        }, 100);
    }
}
</script>

</body>
</html>