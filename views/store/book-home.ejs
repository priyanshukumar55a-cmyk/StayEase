<%- include('../partials/head') %>
</head>
<body class="bg-white min-h-screen items-center justify-center">
    <%- include('../partials/nav') %>

    <div class="text-center mt-40 px-6">
        
        <!-- Big Heading -->
        <h1 class="text-7xl font-extrabold mb-4 tracking-wide text-blue-600">
            Book Your Stay
        </h1>

        <!-- Message -->
        <p class="text-xl text-earth-700 mb-6">
            Select your dates and confirm your booking
        </p>

        <!-- Booking Form -->
        <form action="/homes/<%= home._id %>/book" method="POST" class="bg-white p-6 rounded-lg shadow-md">
            <div class="mb-4">
                <label for="checkin" class="block text-gray-700 font-bold mb-2">Check-in Date</label>
                <input type="date" required id="checkin" name="checkin" class="border rounded py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label for="checkout" class="block text-gray-700 font-bold mb-2">Check-out Date</label>
                <input type="date" required id="checkout" name="checkout" class="border rounded py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-gray-700 font-bold py-2 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 hover:text-white transition duration-300">
                Confirm Booking
            </button>
        </form>

    </div>

</body>
</html>