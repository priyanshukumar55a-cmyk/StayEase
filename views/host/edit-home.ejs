<%- include('../partials/head') %>
</head>

<body class="bg-white min-h-screen flex flex-col">
    
    <%- include('../partials/nav') %>

    <!-- Centering Wrapper -->
    <main class="flex-grow flex items-center justify-center px-4">
        
        <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-md border border-gray-300">
            

            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-fuchsia-600 via-blue-600 to-cyan-400 bg-clip-text text-transparent text-center mb-2 drop-shadow">
                🏡 <%= editing ? "Edit" : "Add" %> Your Home
            </h1>

            <p class="text-lg text-center mb-6 font-semibold text-emerald-600">
                Create or update your listing and <span class="text-pink-500">start earning!</span>
            </p>

            <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" enctype="multipart/form-data" class="space-y-4">

                <input type="hidden" name="id" value="<%= editing ? home._id : '' %>" />
                
                <input 
                    type="text" 
                    name="homeName"
                    value="<%= editing ? home.homeName : '' %>" 
                    placeholder="Enter your house name"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition"
                />
                <input 
                    type="text" 
                    name="price" 
                    value="<%= editing ? home.price : '' %>" 
                    placeholder="Price Per Night"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition"
                />
                <input 
                    type="text" 
                    name="address" 
                    value="<%= editing ? home.address : '' %>" 
                    placeholder="Location"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition"
                />
                <input 
                    type="text" 
                    name="rating" 
                    value="<%= editing ? home.rating : '' %>" 
                    placeholder="rating"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition"
                />
                <input 
                    type="file" 
                    name="photo" 
                    accept="image/jpg, image/jpeg, image/png"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition"
                />

                <textarea 
                    name="description" 
                    placeholder="Describe your home"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition"><%= editing ? home.description : ''%></textarea>


                <input 
                    type="submit" value="<%= editing ? "Update Home" : "Add Home" %>"
                    class="w-full bg-gradient-to-r from-indigo-600 via-purple-500 to-pink-500 text-white py-2 rounded-lg font-extrabold shadow-lg hover:from-pink-500 hover:to-indigo-600 hover:scale-105 transition-all duration-300 cursor-pointer tracking-wide text-lg"
                >
                </input>

            </form>
        </div>

    </main>

</body>
</html>