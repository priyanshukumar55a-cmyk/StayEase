<%- include('../partials/head') %>
</head>
<body class="bg-white font-sans">
    <%- include('../partials/nav') %>

    <!-- Hero Section -->
    <main class="max-w-6xl mx-auto px-4 py-10">
        <h2 class="text-4xl font-extrabold text-blue-600 text-center mb-2">
            Your Listings
        </h2>
        <p class="text-center text-earth-800 text-lg mb-8">Manage and update your amazing properties</p>

        <div class="max-w-6xl mx-auto mt-10 px-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

        <% registeredHomes.forEach(home => { %>
            
            <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 overflow-hidden border border-gray-200 hover:-translate-y-1">
                
                <!-- Image -->
                <div class="overflow-hidden">
                    <img 
                        src="<%= home.photo || 'https://via.placeholder.com/400x300?text=No+Image' %>" 
                        alt="<%= home.homeName %>"
                        class="w-full h-48 object-cover hover:scale-105 transition duration-300"
                    />
                </div>

                <!-- Map Section -->
                <div id="mapSection-<%= home._id %>" class="hidden h-48">
                    <div 
                        id="map-<%= home._id %>" 
                        class="w-full h-full"
                        data-lat="<%= home.location.coordinates[1] %>"
                        data-lng="<%= home.location.coordinates[0] %>">
                    </div>
                </div>
                <!-- Tabs -->
                <button 
                onclick="toggleMap('<%= home._id %>')" 
                id="mapBtn-<%= home._id %>"
                class="px-3 py-1 bg-blue-600 text-white rounded text-sm font-semibold hover:bg-blue-700 transition">
                View Map
                </button>

                <!-- Content -->
                <div class="p-4">
                    
                    <!-- House Name -->
                    <h2 class="text-lg font-bold text-earth-800 mb-1 truncate">
                        <%= home.homeName %>
                    </h2>

                    <!-- address -->
                    <p class="text-earth-700 text-sm mb-2">
                        📍 <%= home.address %>
                    </p>

                    <!-- location -->
                    <p class="text-gray-600 text-sm mb-2">
                        <% if (home.location && home.location.coordinates) { %>
                            🌍 <%= home.location.coordinates.join(', ') %>
                        <% } else { %>
                            🌍 Location not available
                        <% } %>
                    </p>

                    <!-- Rating -->
                    <p class="text-primary-700 text-sm font-semibold mb-2">
                        ⭐ <%= home.rating %> / 5
                    </p>

                    <!-- Price -->
                    <p class="text-earth-900 font-semibold text-lg mb-4">
                        ₹<%= home.price %> 
                        <span class="text-earth-700 text-sm font-normal">/ night</span>
                    </p>

                    <!--Edit Button-->
                    <a href="/host/edit-home/<%=home._id%>?editing=true"
                        class="block w-full bg-blue-600 text-white p-2 rounded-lg font-semibold hover:bg-blue-700 hover:shadow-lg transition duration-300 mt-2 text-center">
                        Edit
                    </a>
                    
                    <!--Delete Button-->
                    <form action="/host/delete-home/<%= home._id %>" method="post">
                        <button type="submit"
                            class="w-full bg-red-500 text-white p-2 rounded-lg font-semibold hover:bg-red-600 hover:shadow-lg transition duration-300 mt-2">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

        <% }) %>

    </div>
    </main>
<script>
const maps = {};
const openedMaps = new Set();

function toggleMap(id) {
    const mapSection = document.getElementById('mapSection-' + id);
    const mapDiv = document.getElementById('map-' + id);
    const btn = document.getElementById('mapBtn-' + id);

    // 👉 CLOSE MAP
    if (openedMaps.has(id)) {
        mapSection.classList.add('hidden');
        openedMaps.delete(id);

        btn.innerText = "View Map";
        btn.className = "px-3 py-1 bg-blue-600 text-white rounded text-sm font-semibold hover:bg-blue-700 transition";
        return;
    }

    // 👉 Close all other maps
    openedMaps.forEach(openId => {
        document.getElementById('mapSection-' + openId).classList.add('hidden');

        const otherBtn = document.getElementById('mapBtn-' + openId);
        if (otherBtn) {
            otherBtn.innerText = "View Map";
            otherBtn.className = "px-3 py-1 bg-blue-600 text-white rounded text-sm font-semibold hover:bg-blue-700 transition";
        }
    });

    openedMaps.clear();

    // 👉 OPEN MAP
    mapSection.classList.remove('hidden');
    openedMaps.add(id);

    btn.innerText = "Close Map";
    btn.className = "px-3 py-1 bg-red-500 text-white rounded text-sm font-semibold hover:bg-red-600 transition";

    // 👉 Initialize map once
    if (!maps[id]) {
        const lat = parseFloat(mapDiv.dataset.lat || 28.6139);
        const lng = parseFloat(mapDiv.dataset.lng || 77.2090);

        const map = L.map('map-' + id).setView([lat, lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([lat, lng])
            .addTo(map)
            .bindPopup("<b>Location</b>")
            .openPopup();

        maps[id] = map;
    } else {
        setTimeout(() => {
            maps[id].invalidateSize();
        }, 100);
    }
}
</script>
</body>
</html>