<%- include('../partials/head') %>
</head>
<body class="bg-white font-sans">
    <%- include('../partials/nav') %>

    <main class="max-w-6xl mx-auto px-4 py-10">
        <h2 class="text-4xl font-extrabold text-blue-600 text-center mb-2">
            Your Listings
        </h2>
        <p class="text-center text-gray-600 text-lg mb-8">
            Manage and update your amazing properties
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

        <% registeredHomes.forEach(home => { %>
            
            <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 overflow-hidden border border-gray-200">
                
                <!-- Image -->
                <div class="overflow-hidden">
                    <img 
                        src="<%= home.photo || 'https://via.placeholder.com/400x300?text=No+Image' %>" 
                        alt="<%= home.homeName %>"
                        class="w-full h-48 object-cover hover:scale-105 transition duration-300"
                    />
                </div>

                <!-- Map Section -->
                <div id="mapSection-<%= home._id %>" class="hidden h-48">
                    <div 
                        id="map-<%= home._id %>" 
                        class="w-full h-full"
                        data-lat="<%= home.location?.coordinates ? home.location.coordinates[1] : '' %>"
                        data-lng="<%= home.location?.coordinates ? home.location.coordinates[0] : '' %>">
                    </div>
                </div>

                <!-- Toggle Button -->
                <div class="p-2 bg-gray-100">
                    <button 
                        onclick="toggleMap('<%= home._id %>')" 
                        id="mapBtn-<%= home._id %>"
                        class="px-3 py-1 bg-blue-600 text-white rounded text-sm font-semibold hover:bg-blue-700 transition">
                        View Map
                    </button>
                </div>

                <!-- Content -->
                <div class="p-4">
                    
                    <h2 class="text-lg font-bold text-gray-800 mb-1 truncate">
                        <%= home.homeName %>
                    </h2>

                    <p class="text-gray-600 text-sm mb-2">
                        📍 <%= home.address || "Location not available" %>
                    </p>

                    <p class="text-yellow-500 text-sm font-semibold mb-2">
                        ⭐ <%= home.rating %> / 5
                    </p>

                    <p class="text-gray-900 font-semibold text-lg mb-4">
                        ₹<%= home.price %> 
                        <span class="text-gray-500 text-sm font-normal">/ night</span>
                    </p>

                    <!-- Edit -->
                    <a href="/host/edit-home/<%=home._id%>?editing=true"
                        class="block w-full bg-blue-600 text-white p-2 rounded-lg font-semibold hover:bg-blue-700 transition text-center">
                        Edit
                    </a>
                    
                    <!-- Delete -->
                    <form action="/host/delete-home/<%= home._id %>" method="post">
                        <button type="submit"
                            class="w-full bg-red-500 text-white p-2 rounded-lg font-semibold hover:bg-red-600 transition mt-2">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

        <% }) %>

        </div>
    </main>

<script>
const maps = {};
const openedMaps = new Set();

function toggleMap(id) {
    const mapSection = document.getElementById('mapSection-' + id);
    const mapDiv = document.getElementById('map-' + id);
    const btn = document.getElementById('mapBtn-' + id);

    // CLOSE
    if (openedMaps.has(id)) {
        mapSection.classList.add('hidden');
        openedMaps.delete(id);
        btn.innerText = "View Map";
        return;
    }

    // CLOSE ALL OTHERS
    openedMaps.forEach(openId => {
        document.getElementById('mapSection-' + openId).classList.add('hidden');
        document.getElementById('mapBtn-' + openId).innerText = "View Map";
    });
    openedMaps.clear();

    // OPEN
    mapSection.classList.remove('hidden');
    openedMaps.add(id);
    btn.innerText = "Close Map";

    // INIT MAP
    if (!maps[id]) {
        const lat = parseFloat(mapDiv.dataset.lat);
        const lng = parseFloat(mapDiv.dataset.lng);

        // ❗ SAFE CHECK
        if (isNaN(lat) || isNaN(lng)) {
            mapDiv.innerHTML = "<p class='text-center text-red-500 mt-4'>Location not available</p>";
            return;
        }

        const map = L.map('map-' + id).setView([lat, lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([lat, lng])
            .addTo(map)
            .bindPopup("📍 Property Location")
            .openPopup();

        maps[id] = map;
    } else {
        setTimeout(() => maps[id].invalidateSize(), 200);
    }
}
</script>

</body>
</html>